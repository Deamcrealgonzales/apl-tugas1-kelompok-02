        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart LR\n    BRW[\&quot;Browser Pengguna&lt;br/&gt;(Mahasiswa / Dosen)\&quot;]\n    APP[\&quot;Server Aplikasi Kelas&lt;br/&gt;(Pendaftaran, Materi, Akses, Pengumuman)\&quot;]\n    AUT[\&quot;Layanan Autentikasi SPADA\&quot;]\n    CCH[\&quot;Cache\&quot;]\n    DB[(\&quot;Basis Data SPADA&lt;br/&gt;Data Kelas&lt;br/&gt;Data Pendaftaran&lt;br/&gt;Data Materi&lt;br/&gt;Data Pengumuman&lt;br/&gt;Data Pengguna\&quot;)]\n    FS[(\&quot;Penyimpanan Berkas Materi\&quot;)]\n    ANT[\&quot;Antrean Notifikasi\&quot;]\n    WRK[\&quot;Worker Notifikasi\&quot;]\n    GWY[\&quot;Gateway Email / Push\&quot;]\n\n    BRW &lt;--&gt;|\&quot;HTTPS: permintaan / respons\&quot;| APP\n\n    APP &lt;--&gt;|\&quot;HTTPS/API: validasi akun\&quot;| AUT\n\n    APP &lt;--&gt;|\&quot;Baca / tulis cache\&quot;| CCH\n\n    APP &lt;--&gt;|\&quot;SQL: baca / tulis data\&quot;| DB\n\n    APP &lt;--&gt;|\&quot;File I/O: unggah / unduh\&quot;| FS\n\n    APP --&gt;|\&quot;Kirim pesan notifikasi\&quot;| ANT\n\n    ANT --&gt;|\&quot;Pesan untuk diproses\&quot;| WRK\n\n    WRK &lt;--&gt;|\&quot;SQL: baca penerima / simpan status\&quot;| DB\n\n    WRK &lt;--&gt;|\&quot;SMTP/API: kirim / terima status\&quot;| GWY\n\n    classDef asr fill:#f8cecc,stroke:#b85450,color:#000\n    classDef biasa fill:#dae8fc,stroke:#6c8ebf,color:#000\n    classDef data fill:#fff2cc,stroke:#d6b656,color:#000\n    classDef luar fill:#e1d5e7,stroke:#9673a6,color:#000\n\n    class CCH,ANT,WRK asr\n    class BRW,APP,AUT biasa\n    class DB,FS data\n    class GWY luar\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sT2RrKtd0kaoK2qD5MD3-20">
