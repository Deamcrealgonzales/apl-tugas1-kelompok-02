  <diagram id="WiykgZufqQ9K44cD0HVk" name="Struktur Alokasi">
    <mxGraphModel dx="1120" dy="661" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    %% A. PENUGASAN MODUL KEPADA TIM\n    subgraph TEAM[\&quot;PENUGASAN MODUL KE TIM (ALOKASI KERJA)\&quot;]\n        direction LR\n\n        subgraph T1[\&quot;TIM 1 - ANTARMUKA\&quot;]\n            direction TB\n            TPK[\&quot;Tampilan Pendaftaran Kelas\&quot;]\n            TMT[\&quot;Tampilan Materi&lt;br/&gt;(Unggah dan Akses)\&quot;]\n            TPG[\&quot;Tampilan Pengumuman\&quot;]\n        end\n\n        subgraph T2[\&quot;TIM 2 - LOGIKA LAYANAN KELAS\&quot;]\n            direction TB\n            PPK[\&quot;Pengelola Pendaftaran Kelas\&quot;]\n            PMT[\&quot;Pengelola Materi\&quot;]\n            PPG[\&quot;Pengelola Pengumuman\&quot;]\n            PNO[\&quot;Pengiriman Notifikasi\&quot;]\n        end\n\n        subgraph T3[\&quot;TIM 3 - DATA DAN KEAMANAN\&quot;]\n            direction TB\n            VHA[\&quot;Validasi Hak Akses\&quot;]\n            VBK[\&quot;Validasi Berkas\&quot;]\n            ADK[\&quot;Akses Data Kelas dan Pendaftaran\&quot;]\n            APB[\&quot;Akses Data Materi dan Berkas\&quot;]\n            ADP[\&quot;Akses Data Pengumuman\&quot;]\n        end\n    end\n\n    %% B. PENEMPATAN KOMPONEN PADA LINGKUNGAN\n    subgraph DEP[\&quot;PENEMPATAN PERANGKAT LUNAK PADA LINGKUNGAN SISTEM\&quot;]\n        direction TB\n\n        subgraph CLIENT[\&quot;PERANGKAT PENGGUNA\&quot;]\n            BRW[\&quot;Browser Pengguna&lt;br/&gt;(Mahasiswa / Dosen)\&quot;]\n        end\n\n        subgraph SERVER[\&quot;SERVER APLIKASI (CLOUD KAMPUS)\&quot;]\n            direction LR\n            APP[\&quot;Server Aplikasi Kelas\&quot;]\n            CCH[\&quot;Cache\&quot;]\n            ANT[\&quot;Antrean Notifikasi\&quot;]\n            WRK[\&quot;Worker Notifikasi\&quot;]\n        end\n\n        subgraph DATA[\&quot;SERVER DATA DAN PENYIMPANAN KAMPUS\&quot;]\n            direction LR\n            DB[(\&quot;Basis Data Kelas&lt;br/&gt;Data Kelas&lt;br/&gt;Pendaftaran&lt;br/&gt;Materi&lt;br/&gt;Pengumuman\&quot;)]\n            FS[(\&quot;Penyimpanan&lt;br/&gt;Berkas Materi\&quot;)]\n        end\n\n        subgraph EXTERNAL[\&quot;LAYANAN PENDUKUNG DAN EKSTERNAL\&quot;]\n            direction LR\n            AUT[\&quot;Layanan Autentikasi&lt;br/&gt;(PDTI)\&quot;]\n            GWY[\&quot;Gateway Email / Push\&quot;]\n        end\n\n        %% HUBUNGAN ANTARKOMPONEN\n        BRW &lt;--&gt;|\&quot;HTTPS\&quot;| APP\n\n        APP &lt;--&gt;|\&quot;HTTPS / API\&quot;| AUT\n\n        APP &lt;--&gt;|\&quot;Baca / Tulis Cache\&quot;| CCH\n\n        APP &lt;--&gt;|\&quot;SQL\&quot;| DB\n\n        APP &lt;--&gt;|\&quot;File I/O\&quot;| FS\n\n        APP --&gt;|\&quot;Kirim Pesan\&quot;| ANT\n\n        ANT --&gt;|\&quot;Pesan untuk Diproses\&quot;| WRK\n        WRK --&gt;|\&quot;Konfirmasi Penerimaan (ACK)\&quot;| ANT\n\n        WRK &lt;--&gt;|\&quot;SQL\&quot;| DB\n\n        WRK &lt;--&gt;|\&quot;SMTP / API\&quot;| GWY\n    end\n\n    %% WARNA TIM\n    classDef tim fill:#d5e8d4,stroke:#82b366,color:#000,stroke-width:1.5px\n\n    %% WARNA INFRASTRUKTUR\n    classDef utama fill:#dae8fc,stroke:#6c8ebf,color:#000,stroke-width:1.5px\n    classDef pendukung fill:#f8cecc,stroke:#b85450,color:#000,stroke-width:1.5px\n    classDef data fill:#fff2cc,stroke:#d6b656,color:#000,stroke-width:1.5px\n    classDef eksternal fill:#e1d5e7,stroke:#9673a6,color:#000,stroke-width:1.5px\n\n    class TPK,TMT,TPG,PPK,PMT,PPG,PNO,VHA,VBK,ADK,APB,ADP tim\n\n    class BRW,APP,AUT utama\n    class CCH,ANT,WRK pendukung\n    class DB,FS data\n    class GWY eksternal\n\n    style TEAM fill:#ffffff,stroke:#7a7a7a,stroke-width:2px\n    style DEP fill:#ffffff,stroke:#7a7a7a,stroke-width:2px\n    style T1 fill:#f5fff5,stroke:#82b366\n    style T2 fill:#f5fff5,stroke:#82b366\n    style T3 fill:#f5fff5,stroke:#82b366\n    style CLIENT fill:#fff5f5,stroke:#b854a0\n    style SERVER fill:#f0fbff,stroke:#00a6a6\n    style DATA fill:#fffaf0,stroke:#d6b656\n    style EXTERNAL fill:#f5fff5,stroke:#82b366\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="69XWLAvI-NjY1e6FgN93-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
