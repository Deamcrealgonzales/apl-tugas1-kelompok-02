        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    %% LAPISAN TAMPILAN\n    subgraph L1[\&quot;LAPISAN TAMPILAN\&quot;]\n        direction LR\n        TPK[\&quot;Tampilan Pendaftaran&lt;br/&gt;Kelas\&quot;]\n        TMT[\&quot;Tampilan Materi&lt;br/&gt;(Unggah dan Akses)\&quot;]\n        TPG[\&quot;Tampilan Pengumuman\&quot;]\n    end\n\n    %% LAPISAN LOGIKA\n    subgraph L2[\&quot;LAPISAN LOGIKA APLIKASI\&quot;]\n        direction TB\n\n        subgraph L2A[\&quot;MODUL PENGELOLAAN LAYANAN\&quot;]\n            direction LR\n            PPK[\&quot;Pengelola Pendaftaran&lt;br/&gt;Kelas\&quot;]\n            PMT[\&quot;Pengelola Materi\&quot;]\n            PPG[\&quot;Pengelola Pengumuman\&quot;]\n        end\n\n        subgraph L2B[\&quot;MODUL PENDUKUNG\&quot;]\n            direction LR\n            VHA[\&quot;Validasi Hak Akses\&quot;]\n            VBK[\&quot;Validasi Berkas\&quot;]\n            PNO[\&quot;Pengiriman Notifikasi\&quot;]\n        end\n    end\n\n    %% LAPISAN DATA\n    subgraph L3[\&quot;LAPISAN AKSES DATA\&quot;]\n        direction LR\n        ADK[\&quot;Akses Data Kelas,&lt;br/&gt;Pendaftaran dan Hak Akses\&quot;]\n        APB[\&quot;Akses Data Materi&lt;br/&gt;dan Berkas\&quot;]\n        ADP[\&quot;Akses Data Pengumuman\&quot;]\n    end\n\n    %% HUBUNGAN TAMPILAN KE LOGIKA\n    TPK --&gt;|\&quot;menggunakan\&quot;| PPK\n    TMT --&gt;|\&quot;menggunakan\&quot;| PMT\n    TPG --&gt;|\&quot;menggunakan\&quot;| PPG\n\n    %% HUBUNGAN MODUL LOGIKA\n    PPK --&gt;|\&quot;menggunakan\&quot;| VHA\n    PMT --&gt;|\&quot;menggunakan\&quot;| VHA\n    PMT --&gt;|\&quot;menggunakan\&quot;| VBK\n    PPG --&gt;|\&quot;menggunakan\&quot;| VHA\n    PPG --&gt;|\&quot;menggunakan\&quot;| PNO\n\n    %% HUBUNGAN LOGIKA KE DATA\n    PPK --&gt;|\&quot;menggunakan\&quot;| ADK\n    PMT --&gt;|\&quot;menggunakan\&quot;| APB\n    PPG --&gt;|\&quot;menggunakan\&quot;| ADP\n    VHA --&gt;|\&quot;menggunakan\&quot;| ADK\n\n    %% WARNA MODUL\n    classDef tampilan fill:#dae8fc,stroke:#6c8ebf,color:#000,stroke-width:1.5px\n    classDef logika fill:#d5e8d4,stroke:#82b366,color:#000,stroke-width:1.5px\n    classDef data fill:#fff2cc,stroke:#d6b656,color:#000,stroke-width:1.5px\n\n    class TPK,TMT,TPG tampilan\n    class PPK,PMT,PPG,VHA,VBK,PNO logika\n    class ADK,APB,ADP data\n\n    style L1 fill:#f5f9ff,stroke:#6c8ebf,stroke-width:2px\n    style L2 fill:#f5fff5,stroke:#82b366,stroke-width:2px\n    style L2A fill:#ffffff,stroke:#82b366\n    style L2B fill:#ffffff,stroke:#82b366\n    style L3 fill:#fffaf0,stroke:#d6b656,stroke-width:2px\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="8z0wIo3Gds2yVSj9aD0K-1">
